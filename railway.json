{
  "$schema": "https://railway.app/schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm run build && npm install tsx",
    "startCommand": "npx tsx server.ts"
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  },
  "environmentVariables": {
    "NODE_ENV": "production",
    "PORT": "8080"
  }
}
